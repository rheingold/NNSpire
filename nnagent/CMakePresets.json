{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },

  "configurePresets": [
    {
      "name": "default",
      "displayName": "NNAgent Core — Ninja (MinGW)",
      "description": "Builds and tests the NNAgent C++ core library.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "PATH": "D:/plachy/Dokumenty/Dev/Qt/Tools/CMake_64/bin;D:/plachy/Dokumenty/Dev/Qt/Tools/Ninja;C:/msys64/mingw64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "D:/plachy/Dokumenty/Dev/Qt/Tools/Ninja/ninja.exe",
        "NNAgent_BUILD_TESTS": "ON",
        "NNAgent_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "msvc",
      "displayName": "NNAgent Core — Visual Studio 2022 x64",
      "description": "Builds and tests the NNAgent C++ core with MSVC.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-msvc",
      "cacheVariables": {
        "NNAgent_BUILD_TESTS": "ON",
        "NNAgent_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "NNAgent Core — Debug (Ninja)",
      "description": "Debug build for stepping through test failures.",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "msvc",
      "configurePreset": "msvc"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    }
  ],

  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
